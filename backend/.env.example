# OpenRouter: MiniMax M3 genera resumenes y respuestas del chat.
OPENROUTER_API_KEY="tu_openrouter_api_key_aqui"
OPENROUTER_MODEL="minimax/minimax-m3:free"

# ScrapeGraphAI. Se aceptan ambos nombres; SGAI_API_KEY es el oficial.
SGAI_API_KEY="tu_sgai_api_key_aqui"
# API_SCRAPEGRAPHAI="tu_sgai_api_key_aqui"

# Opcionales
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=UniNews UPLA
SGAI_TIMEOUT=120
RAG_MAX_DISTANCE=0.95
