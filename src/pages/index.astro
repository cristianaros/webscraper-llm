---
import MainLayout from "@/layouts/main.astro";
import NewsPage from "@/components/NewsPage";
---

<MainLayout title="Noticias" activePage="home">
  <!-- Hero con ticker (signature element editorial) -->
  <section class="border-b border-border bg-gradient-to-b from-background to-muted/30">
    <div class="mx-auto max-w-screen-xl px-6 py-12 md:py-16">
      <div class="flex flex-col gap-4">
        <!-- Eyebrow -->
        <div class="flex items-center gap-2">
          <span class="h-px w-8 bg-primary"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-primary">Portal Institucional</span>
        </div>

        <!-- Headline editorial -->
        <h1 class="font-display text-4xl font-normal leading-tight text-foreground md:text-5xl lg:text-6xl">
          Noticias <em class="not-italic text-primary">universitarias</em><br />
          con inteligencia artificial
        </h1>

        <p class="max-w-xl text-base text-muted-foreground leading-relaxed">
          Consulta, busca y explora noticias. Nuestro asistente IA responde preguntas basadas en el contenido publicado usando Google Gemini y RAG.
        </p>
      </div>
    </div>

    <!-- Ticker band (signature element) -->
    <div class="overflow-hidden border-t border-border bg-muted/40 py-3">
      <div class="ticker-track" id="ticker-track">
        <!-- Inyectado por NewsPage client-side -->
        <span class="whitespace-nowrap px-8 text-xs font-medium text-muted-foreground">Cargando titulares...</span>
      </div>
    </div>
  </section>

  <!-- React Island: Grid de noticias con filtros -->
  <NewsPage client:load />
</MainLayout>
