---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  activePage?: "home" | "admin" | "chat";
}

const {
  title,
  description = "Plataforma de periodismo universitario e inteligencia artificial con RAG.",
  activePage = "home",
} = Astro.props;

const todayStr = new Intl.DateTimeFormat("es-ES", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date());
const formattedDate = todayStr.charAt(0).toUpperCase() + todayStr.slice(1);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — UniNews</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23D8232A'/><text x='50%' y='65%' font-family='sans-serif' font-weight='bold' font-size='55' fill='white' text-anchor='middle'>UN</text></svg>" />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    <!-- Barra superior de utilidad y edición -->
    <div class="border-b border-border/80 bg-background text-[11px] text-muted-foreground">
      <div class="mx-auto flex max-w-screen-xl items-center justify-between px-4 py-1.5 sm:px-6">
        <div class="flex items-center gap-3">
          <span class="font-medium text-foreground/80">{formattedDate}</span>
          <span class="hidden sm:inline text-border">|</span>
          <span class="hidden sm:inline">Edición Digital · Noticias Universitarias</span>
        </div>

        <div class="flex items-center gap-4">
          <nav class="flex items-center gap-3 font-medium">
            <a
              href="/"
              class:list={[
                "transition-colors hover:text-foreground",
                activePage === "home" ? "text-primary font-semibold" : "text-muted-foreground",
              ]}
            >
              Noticias
            </a>
            <span class="text-border">·</span>
            <a
              href="/admin"
              class:list={[
                "transition-colors hover:text-foreground",
                activePage === "admin" ? "text-primary font-semibold" : "text-muted-foreground",
              ]}
            >
              Administrar
            </a>
            <span class="text-border">·</span>
            <a
              href="/chat"
              class:list={[
                "inline-flex items-center gap-1 transition-colors hover:text-foreground",
                activePage === "chat" ? "text-primary font-semibold" : "text-primary/90 font-medium",
              ]}
            >
              <span class="inline-block size-1.5 rounded-full bg-primary animate-pulse"></span>
              Asistente IA
            </a>
          </nav>
        </div>
      </div>
    </div>

    <!-- Cabecera Principal (Masthead estilo La Tercera con logo UN + UNINEWS) -->
    <header class="border-b border-border bg-background">
      <div class="mx-auto max-w-screen-xl px-4 py-5 sm:px-6">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <!-- Espacio izquierdo en desktop (o lema informativo) -->
          <div class="hidden lg:flex flex-col text-xs text-muted-foreground max-w-xs leading-relaxed">
            <span class="font-semibold text-foreground tracking-wide uppercase text-[10px]">Portal de Noticias</span>
            <span>UPLA y Sistema Universitario Nacional con Inteligencia Artificial</span>
          </div>

          <!-- Logotipo central / derecho réplica exacta del estilo La Tercera -->
          <a href="/" class="flex flex-col items-center sm:items-end no-underline group">
            <div class="flex items-center gap-2.5">
              <!-- Recuadro rojo 'UN' idéntico a 'LT' de La Tercera -->
              <div class="flex size-9 sm:size-10 items-center justify-center bg-[#D8232A] text-white font-black text-xl sm:text-2xl tracking-tighter shadow-xs select-none">
                UN
              </div>
              <!-- Tipografía UNINEWS en mayúsculas negritas sin serifa -->
              <span class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground transition-colors group-hover:text-[#D8232A]">
                UNINEWS
              </span>
            </div>
            <!-- Subtítulo en cursiva 'periodismo universitario...' -->
            <p class="font-display italic text-xs sm:text-sm text-muted-foreground tracking-normal mt-0.5 select-none">
              periodismo universitario con inteligencia artificial
            </p>
          </a>
        </div>
      </div>
    </header>

    <!-- Contenido principal -->
    <div class="flex-1">
      <slot />
    </div>

    <!-- Pie de página editorial estilo periódico -->
    <footer class="mt-16 border-t-2 border-foreground bg-background py-10 text-xs text-muted-foreground">
      <div class="mx-auto max-w-screen-xl px-4 sm:px-6">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-6 border-b border-border">
          <div class="flex items-center gap-2.5">
            <div class="flex size-7 items-center justify-center bg-[#D8232A] text-white font-black text-base select-none">
              UN
            </div>
            <span class="text-xl font-bold tracking-tight text-foreground">UNINEWS</span>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-6 font-medium text-foreground/80">
            <a href="/" class="hover:text-primary transition-colors">Portada</a>
            <a href="/admin" class="hover:text-primary transition-colors">Panel de Redacción</a>
            <a href="/chat" class="hover:text-primary transition-colors">Consulta Inteligente RAG</a>
          </div>
        </div>
        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px]">
          <p>© {new Date().getFullYear()} UniNews. Adaptación de periodismo universitario e inteligencia artificial.</p>
          <p class="text-muted-foreground">Fuentes institucionales UPLA y OpenRouter LLM</p>
        </div>
      </div>
    </footer>
  </body>
</html>
